{
  "name": "@amatla/api",
  "version": "0.0.1",
  "private": true,
  "description": "tRPC router + servidor Fastify",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cola-media": {
      "types": "./dist/cola-media.d.ts",
      "default": "./dist/cola-media.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/start.ts",
    "start": "node --env-file-if-exists=.env dist/start.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo \"lint pendiente (se configura con ESLint en tarea de CI)\""
  },
  "dependencies": {
    "@amatla/config": "*",
    "@amatla/crypto": "*",
    "@amatla/db": "*",
    "@amatla/storage": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@trpc/server": "^11.0.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "ioredis": "5.10.1",
    "isomorphic-dompurify": "^3.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
