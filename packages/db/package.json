{
  "name": "@amatla/db",
  "version": "0.0.1",
  "private": true,
  "description": "Prisma schema + cliente compartido (PostgreSQL 16)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo \"lint pendiente (se configura con ESLint en tarea de CI)\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@amatla/config": "*",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
