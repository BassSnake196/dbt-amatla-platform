{
  "name": "@amatla/worker-media",
  "version": "0.0.1",
  "private": true,
  "description": "Worker BullMQ — escaneo ClamAV de subidas; luego video/imágenes (Sharp, FFmpeg)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo \"lint pendiente (se configura con ESLint en tarea de CI)\""
  },
  "dependencies": {
    "@amatla/config": "*",
    "@amatla/db": "*",
    "@amatla/storage": "*",
    "bullmq": "^5.34.0",
    "file-type": "^19.6.0",
    "ioredis": "5.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
