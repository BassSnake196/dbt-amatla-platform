# ===== Base de datos =====
DATABASE_URL="postgresql://amatla:amatla_dev@localhost:5432/amatla_dev"

# ===== Redis =====
REDIS_URL="redis://localhost:6379"

# ===== Cifrado (field-level AES-256-GCM) =====
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=""
ENCRYPTION_SALT=""

# ===== NextAuth =====
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Correo transaccional =====
RESEND_API_KEY=""

# ===== Cloudflare =====
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="amatla-files"

# ===== Almacenamiento mock local (SOLO desarrollo — R2 lo reemplaza en prod) =====
# Defaults sensatos si se omiten: <raíz del monorepo>/.almacen-dev,
# http://localhost:3000/api/almacen-dev y un secreto fijo de desarrollo.
STORAGE_LOCAL_DIR=""
STORAGE_PUBLIC_URL="http://localhost:3000/api/almacen-dev"
STORAGE_SIGNING_SECRET="amatla-dev-almacen-secreto"

# ===== Stream mock local (SOLO desarrollo — Cloudflare Stream lo reemplaza en prod) =====
# Defaults sensatos si se omiten: <raíz del monorepo>/.stream-dev,
# http://localhost:3000/api/stream-dev y secretos fijos de desarrollo.
STREAM_LOCAL_DIR=""
STREAM_PUBLIC_URL="http://localhost:3000/api/stream-dev"
STREAM_SIGNING_SECRET="amatla-dev-stream-secreto"
STREAM_WEBHOOK_SECRET="amatla-dev-stream-webhook-secreto"

# ===== ClamAV (contenedor de docker-compose) =====
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# ===== IA =====
ANTHROPIC_API_KEY=""

# ===== Monitoreo =====
SENTRY_DSN=""
AXIOM_TOKEN=""
